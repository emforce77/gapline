# Model calls (Gemini via OpenRouter while experimenting)
OPENROUTER_API_KEY=
# Google Cloud project for Speech-to-Text and Text-to-Speech
GCP_PROJECT_ID=
# Local runs only: gcloud configuration whose account calls the Google Cloud APIs
GCLOUD_CONFIGURATION=
# Local runs only: a full static ffmpeg build (the container uses the distro package)
FFMPEG_PATH=
# Where projects and runs live (Cloud Run: the mounted Cloud Storage volume)
DATA_DIR=./runtime
# Shared allowance for live runs on the public demo, in USD per day
DAILY_BUDGET_USD=5
