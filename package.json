{
  "name": "scene-ad",
  "version": "0.1.0",
  "private": true,
  "description": "Scene: automatic audio description that fits the silence between the lines.",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack -H 127.0.0.1 -p 21960",
    "build": "next build",
    "start": "next start -H ${HOSTNAME_BIND:-127.0.0.1} -p ${PORT:-21960}",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "samples": "node --env-file=.env.local --import tsx scripts/prepare-samples.ts && node --env-file=.env.local --import tsx scripts/seed-samples.ts",
    "pipeline": "node --env-file=.env.local --import tsx scripts/run-pipeline.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@google-cloud/storage": "7.22.0",
    "next": "16.3.5",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
